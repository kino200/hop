{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "managed",
  "description": "Memory-only protected HWPX editor with no filesystem, store, log, updater or new-webview permissions",
  "windows": ["managed"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-is-focused",
    "dialog:default"
  ]
}
